rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{uid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      function validProfile() {
        return request.resource.data.keys().hasAll(['name', 'faculty', 'year'])
          && request.resource.data.keys().hasOnly(['name', 'faculty', 'year'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.faculty in ['business', 'engineering', 'pharmacy', 'agriculture']
          && request.resource.data.year in ['1', '2', '3', '4'];
      }
      allow get: if isOwner();
      allow create, update: if isOwner() && validProfile();
      allow list, delete: if false;
    }
  }
}
